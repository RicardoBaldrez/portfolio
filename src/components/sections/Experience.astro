---
import { jobs } from '../../data/jobs';
import { LOGOS } from '../../data/logos';

/* a timeline é gerada no build: o HTML já chega pronto para o navegador e para o Google */
const nWork = jobs.filter((j) => !j.edu).length;
const firstEdu = jobs.findIndex((j) => j.edu);
---
<section class="exp" id="experiencia">
  <span class="bignum l" data-n aria-hidden="true" style="top:-10vw">02</span>
  <span class="bignum r" data-n aria-hidden="true" style="bottom:-14vw">03</span>
  <span class="note">section#experiencia · timeline: a linha se desenha com o scroll e acende cada empresa ao passar</span>
  <div class="wrap"><p class="fileline" data-file="git log --empresas"></p></div>
  <div class="wrap exp-grid" data-reveal>
    <div class="exp-head">
      <p class="eyebrow">02 — Experiência</p>
      <h2 class="h2">Onde eu<br>já <span style="color:var(--lime)">deixei</span><br>código.</h2>
      <div class="exp-bar" aria-hidden="true"><i></i></div>
    </div>
    <ol class="jobs" id="jobs">
      <span class="tl-fill" aria-hidden="true"></span><span class="tl-head" aria-hidden="true"></span>
      {jobs.map((j, i) => (
        <>
          {i === firstEdu && (
            <li class="tl-sep"><span class="tl-sep-mark" aria-hidden="true"></span><p class="tl-sep-k">// formação</p><h3 class="tl-sep-t">Formação acadêmica</h3></li>
          )}
          <li class="tl-item" style={`--c:${j.c}`}>
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="tl-date">
              <span>{j.when}</span>
              {(j.now || j.badge) && <span class="tl-now"><i aria-hidden="true"></i>{j.badge || 'atual'}</span>}
            </div>
            <div class="tl-card">
              <span class="num" aria-hidden="true">{j.edu ? '' : '0' + (nWork - i)}</span>
              {j.logos && (
                <div class="tl-logos" aria-hidden="true">
                  {j.logos.map((k, n) => (
                    <>
                      {n > 0 && <i class="lg-x">×</i>}
                      <span class={`lg lg-${k}`} set:html={LOGOS[k]} />
                    </>
                  ))}
                </div>
              )}
              <h3 class={j.logos ? 'sr-only' : undefined}>{j.co}</h3>
              <p class="role">{j.role}</p>
              <p class="desc">{j.desc}</p>
              <div class="chips">{j.tags.map((t) => <span>{t}</span>)}</div>
              {j.did && (
                <details class="tl-mods tl-did"><summary>ver o que eu entreguei</summary><ol>{j.did.map((m) => <li>{m}</li>)}</ol></details>
              )}
              {j.reviews && (
                <details class="tl-mods tl-revs">
                  <summary>
                    <span class="rv-stack" aria-hidden="true">{j.reviews.map((r) => <span style={`background:${r.c}`}>{r.ini}</span>)}</span>
                    <span>ver os reviews</span>
                    <span class="rv-count">{j.reviews.length}</span>
                  </summary>
                  <div class="rv-list">
                    {j.reviews.map((r) => (
                      <article class="rv">
                        <div class="rv-head">
                          <span class="rv-av" style={`background:${r.c}`} aria-hidden="true">{r.ini}</span>
                          <span class="rv-who">{r.role}</span>
                          <span class="rv-act">{r.via === 'linkedin' ? 'recomendou no LinkedIn' : 'aprovou estas mudanças'}</span>
                          <span class="rv-ok">✓ approved</span>
                        </div>
                        <blockquote class="rv-body">{r.text.map((t) => <p>{t}</p>)}</blockquote>
                        <p class="rv-foot"><span>{r.co}</span><span>{r.year}</span></p>
                      </article>
                    ))}
                  </div>
                </details>
              )}
            </div>
          </li>
        </>
      ))}
    </ol>
  </div>
</section>
